@model Exam9.WEB.ViewModels.HomeViewModel

<div class="container mt-4">
    <h1>Электронный кошелёк</h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h4>Мой счёт</h4>
                <p>
                    Номер счёта:
                    <strong>@Model.AccountNumber</strong>
                </p>
                <p>
                    Баланс:
                    <strong id="balance">@Model.Balance?.ToString("N2")</strong>
                </p>
            </div>
        </div>
    }
    else
    {
        <p class="mt-3">Зарегистрируйтесь или войдите, чтобы пользоваться электронным кошельком.</p>

        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Регистрация</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Вход</a>
    }
    
    <div class="card mt-4">
        <div class="card-body">
            <h4>Пополнение счёта</h4>
            <form id="depositForm">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="accountNumber" class="form-label">Номер счёта</label>
                    <input type="text" id="accountNumber" name="accountNumber" class="form-control" maxlength="6" pattern="[0-9]{6}" required />
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">Сумма пополнения</label>
                    <input type="number" id="amount" name="amount" class="form-control" min="0.01" step="0.01" required />
                </div>
                <button type="submit" class="btn btn-primary">Пополнить</button>
            </form>
        </div>
    </div>
    <div id="notification"
         class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3"
         style="z-index: 2000; min-width: 300px;">
    </div>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h4>Перевод средств</h4>
                <form id="transferForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="receiverAccountNumber" class="form-label">Номер счёта получателя</label>
                        <input type="text" id="receiverAccountNumber" name="receiverAccountNumber" class="form-control" maxlength="6" pattern="[0-9]{6}" required />
                    </div>
                    <div class="mb-3">
                        <label for="transferAmount" class="form-label">Сумма перевода</label>
                        <input type="number" id="transferAmount" name="amount" class="form-control" min="0.01" step="0.01" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Перевести</button>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById("depositForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);
            const notification = document.getElementById("notification");

            try {
                const response = await fetch("@Url.Action("Deposit", "Home")", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                notification.textContent = result.message;
                notification.classList.remove("d-none", "alert-success", "alert-danger");
                notification.classList.add(result.success ? "alert-success" : "alert-danger");

                if (result.success) {
                    form.reset();

                    const balanceElement = document.getElementById("balance");

                    if (balanceElement) {
                        const response = await fetch("@Url.Action("GetBalance", "Home")");
                        const balanceData = await response.json();

                        balanceElement.textContent = balanceData.balance.toLocaleString("ru-RU",
                            { minimumFractionDigits: 2, maximumFractionDigits: 2 }
                        );
                    }
                }
            }
            catch {
                notification.textContent = "Произошла ошибка. Попробуйте ещё раз.";
                notification.classList.remove("d-none", "alert-success");
                notification.classList.add("alert-danger");
            }
        });
        document.getElementById("transferForm")?.addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);
            const notification = document.getElementById("notification");

            try {
                const response = await fetch("@Url.Action("Transfer", "Home")", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                notification.textContent = result.message;
                notification.classList.remove("d-none", "alert-success", "alert-danger");
                notification.classList.add(result.success ? "alert-success" : "alert-danger");

                if (result.success) {
                    form.reset();

                    const balanceElement = document.getElementById("balance");

                    if (balanceElement) {
                        const balanceResponse = await fetch("@Url.Action("GetBalance", "Home")");

                        if (balanceResponse.ok) {
                            const balanceData = await balanceResponse.json();

                            balanceElement.textContent = balanceData.balance.toLocaleString(
                                "ru-RU",
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            );
                        }
                    }
                }
            }
            catch {
                notification.textContent = "Произошла ошибка. Попробуйте ещё раз.";
                notification.classList.remove("d-none", "alert-success");
                notification.classList.add("alert-danger");
            }
        });
    </script>
}