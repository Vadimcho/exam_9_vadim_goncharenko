@model Exam9.WEB.ViewModels.HomeViewModel
@inject IStringLocalizer<WalletResource> L
@inject IStringLocalizer<SharedResource> S

<div class="container mt-4">
    <h1>@L["WalletTitle"]</h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h4>@L["MyAccount"]</h4>
                <p>
                    @L["AccountNumber"]:
                    <strong>@Model.AccountNumber</strong>
                </p>
                <p>
                    @L["Balance"]:
                    <strong id="balance">@Model.Balance?.ToString("N2")</strong>
                </p>
            </div>
        </div>
    }
    else
    {
        <p class="mt-3">@L["RegistrationPrompt"]</p>

        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
            @S["Register"]
        </a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
            @S["Login"]
        </a>
    }

    <div class="card mt-4">
        <div class="card-body">
            <h4>@L["DepositTitle"]</h4>
            <form id="depositForm">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="accountNumber" class="form-label">@L["AccountNumber"]</label>
                    <input type="text" id="accountNumber" name="accountNumber" class="form-control" maxlength="6" pattern="[0-9]{6}" required />
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">@L["DepositAmount"]</label>
                    <input type="number" id="amount" name="amount" class="form-control" min="0.01" step="0.01" required />
                </div>
                <button type="submit" class="btn btn-primary">@L["DepositButton"]</button>
            </form>
        </div>
    </div>

    <div id="notification" class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3" style="z-index: 2000; min-width: 300px;"></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h4>@L["TransferTitle"]</h4>
                <form id="transferForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="receiverAccountNumber" class="form-label">@L["ReceiverAccountNumber"]</label>
                        <input type="text" id="receiverAccountNumber" name="receiverAccountNumber" class="form-control" maxlength="6" pattern="[0-9]{6}" required />
                    </div>
                    <div class="mb-3">
                        <label for="transferAmount" class="form-label">@L["TransferAmount"]</label>
                        <input type="number" id="transferAmount" name="amount" class="form-control" min="0.01" step="0.01" required />
                    </div>
                    <button type="submit" class="btn btn-primary">@L["TransferButton"]</button>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["ErrorTryAgain"].Value));

        async function refreshBalance() {
            const balanceElement = document.getElementById("balance");

            if (!balanceElement) return;

            const response = await fetch("@Url.Action("GetBalance", "Home")");

            if (!response.ok) {
                throw new Error("Balance update failed");
            }

            const data = await response.json();

            balanceElement.textContent = data.balance.toLocaleString("ru-RU", {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }

        document.getElementById("depositForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);
            const notification = document.getElementById("notification");

            try {
                const response = await fetch("@Url.Action("Deposit", "Home")", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                notification.textContent = result.message;
                notification.classList.remove("d-none", "alert-success", "alert-danger");
                notification.classList.add(result.success ? "alert-success" : "alert-danger");

                if (result.success) {
                    form.reset();
                    await refreshBalance();
                }
            }
            catch {
                notification.textContent = errorMessage;
                notification.classList.remove("d-none", "alert-success");
                notification.classList.add("alert-danger");
            }
        });

        document.getElementById("transferForm")?.addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);
            const notification = document.getElementById("notification");

            try {
                const response = await fetch("@Url.Action("Transfer", "Home")", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                notification.textContent = result.message;
                notification.classList.remove("d-none", "alert-success", "alert-danger");
                notification.classList.add(result.success ? "alert-success" : "alert-danger");

                if (result.success) {
                    form.reset();
                    await refreshBalance();
                }
            }
            catch {
                notification.textContent = errorMessage;
                notification.classList.remove("d-none", "alert-success");
                notification.classList.add("alert-danger");
            }
        });
    </script>
}
