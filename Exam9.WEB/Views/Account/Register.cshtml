@model Exam9.WEB.ViewModels.RegisterViewModel
@inject IStringLocalizer<AccountResource> L

<div class="container mt-4">
    <h2>@L["RegistrationTitle"]</h2>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">@L["Password"]</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">@L["ConfirmPassword"]</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">@L["RegisterButton"]</button>
    </form>
</div>