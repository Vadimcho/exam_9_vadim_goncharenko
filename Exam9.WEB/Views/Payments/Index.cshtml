
@model Exam9.WEB.ViewModels.PaymentViewModel
@inject IStringLocalizer<PaymentResource> L
@inject IStringLocalizer<SharedResource> S

<div class="container mt-4">
    <h1>@L["PaymentTitle"]</h1>

    <div id="notification" class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3" style="z-index: 2000; min-width: 300px;"></div>
    <div class="card mt-4">
        <div class="card-body">
            <div class="alert alert-info">
                @L["CurrentBalance"]
                <strong id="balance">@L["Loading"]</strong>
            </div>
            <form id="paymentForm">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="providerId" class="form-label">@L["Provider"]</label>
                    <select id="providerId" name="ProviderId" class="form-select" required>
                        <option value="">@L["SelectProvider"]</option>
                        @foreach (var provider in Model.Providers)
                        {
                            <option value="@provider.Id">
                                @provider.Name — @provider.ServiceType
                            </option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="providerAccountNumber" class="form-label">
                        @L["ProviderAccountNumber"]
                    </label>
                    <input type="text" id="providerAccountNumber" name="ProviderAccountNumber" class="form-control" maxlength="50" required />
                    <div class="form-text" id="accountHint">@L["TestAccountHint"]</div>
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">@L["Amount"]</label>
                    <input type="number" id="amount" name="Amount" class="form-control" min="0.01" step="0.01" required />
                </div>
                <button type="submit" class="btn btn-primary">@L["PayButton"]</button>
            </form>
        </div>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-3">@S["BackHome"]</a>
</div>

@section Scripts {
    <script>
        const providerSelect = document.getElementById("providerId");
        const accountHint = document.getElementById("accountHint");

        const testAccounts = {
            "1": ["0555123456", "0555987654"],
            "2": ["0700123456", "0700987654"],
            "3": ["0999123456", "0999987654"],
            "4": ["100001", "100002"],
            "5": ["200001", "200002"]
        };

        const testAccountTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["TestAccount"].Value));

        const defaultHint = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["TestAccountHint"].Value));

        const errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(S["ErrorTryAgain"].Value));

        providerSelect.addEventListener("change", function () {
            const accounts = testAccounts[this.value];

            accountHint.textContent = accounts ? testAccountTemplate.replace("{0}", accounts[0]).replace("{1}", accounts[1]) : defaultHint;
        });

        async function updateBalance() {
            const response = await fetch("@Url.Action("GetBalance", "Home")");

            if (!response.ok) {
                throw new Error("Balance update failed");
            }

            const data = await response.json();

            document.getElementById("balance").textContent = data.balance.toLocaleString("ru-RU", {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }

        updateBalance();

        document.getElementById("paymentForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);
            const notification = document.getElementById("notification");

            try {
                const response = await fetch("@Url.Action("Pay", "Payments")", {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("Payment request failed");
                }

                const result = await response.json();

                notification.textContent = result.message;
                notification.classList.remove("d-none", "alert-success", "alert-danger");
                notification.classList.add(result.success ? "alert-success" : "alert-danger");

                if (result.success) {
                    form.reset();
                    accountHint.textContent = defaultHint;
                    await updateBalance();
                }
            }
            catch {
                notification.textContent = errorMessage;
                notification.classList.remove("d-none", "alert-success");
                notification.classList.add("alert-danger");
            }
        });
    </script>
}