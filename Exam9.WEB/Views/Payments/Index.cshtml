@model Exam9.WEB.ViewModels.PaymentViewModel

<div class="container mt-4">
    <h1>Оплата услуг</h1>
    <div id="notification" class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3" style="z-index: 2000; min-width: 300px;">
    </div>
    <div class="card mt-4">
        <div class="card-body">
            <div class="alert alert-info">
                Текущий баланс:
                <strong id="balance">Загрузка...</strong>
            </div>
            <form id="paymentForm">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="providerId" class="form-label">Поставщик услуг</label>
                    <select id="providerId" name="ProviderId" class="form-select" required>
                        <option value="">Выберите поставщика</option>
                        @foreach (var provider in Model.Providers)
                        {
                            <option value="@provider.Id">
                                @provider.Name — @provider.ServiceType
                            </option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="providerAccountNumber" class="form-label">Номер лицевого счёта</label>
                    <input type="text" id="providerAccountNumber" name="ProviderAccountNumber" class="form-control" maxlength="50" required/>
                    <div class="form-text" id="accountHint">Выберите поставщика, чтобы увидеть тестовый номер лицевого счёта.</div>
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">Сумма оплаты</label>
                    <input type="number" id="amount" name="Amount" class="form-control" min="0.01" step="0.01" required/>
                </div>
                <button type="submit" class="btn btn-primary">Оплатить</button>
            </form>
        </div>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-3">На главную</a>
</div>

@section Scripts {
    <script>
        const providerSelect = document.getElementById("providerId");
        const accountHint = document.getElementById("accountHint");

        const testAccounts = {
            "1": "Тестовый счёт: 0555123456 или 0555987654",
            "2": "Тестовый счёт: 0700123456 или 0700987654",
            "3": "Тестовый счёт: 0999123456 или 0999987654",
            "4": "Тестовый счёт: 100001 или 100002",
            "5": "Тестовый счёт: 200001 или 200002"
        };

        providerSelect.addEventListener("change", function () {
            const providerId = this.value;

            accountHint.textContent = testAccounts[providerId] ?? "Выберите поставщика, чтобы увидеть тестовый номер лицевого счёта.";
        });
        async function updateBalance() {
            const response = await fetch("@Url.Action("GetBalance", "Home")");

            if (!response.ok) {
                throw new Error("Не удалось получить баланс.");
            }

            const data = await response.json();

            document.getElementById("balance").textContent = data.balance.toLocaleString("ru-RU", {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }

        updateBalance();
        document.getElementById("paymentForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);
            const notification = document.getElementById("notification");

            try {
                const response = await fetch("@Url.Action("Pay", "Payments")", {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    throw new Error("Ошибка сервера.");
                }

                const result = await response.json();

                notification.textContent = result.message;
                notification.classList.remove("d-none", "alert-success", "alert-danger");
                notification.classList.add(result.success ? "alert-success" : "alert-danger"
                );

                if (result.success) {
                    form.reset();
                    await updateBalance();
                }
            }
            catch {
                notification.textContent = "Произошла ошибка. Попробуйте ещё раз.";
                notification.classList.remove("d-none", "alert-success");
                notification.classList.add("alert-danger");
            }
        });
    </script>
}